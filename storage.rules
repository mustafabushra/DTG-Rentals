rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Firebase Storage — مغلق بالكامل عن قصد.
//
// **ما كان قبل هذا:** `allow read: if request.auth != null` على `/{allPaths=**}`
// أي أن **أي مستخدم مسجَّل دخوله** — ومنهم المالك التابع من أي مؤسسة، لأن
// المصادقة على مستوى المشروع كله — يقرأ **كل ملف في الحاوية**. بلا عزل مؤسسات
// ولا تقييد مسار. وهذا تسريب بيانات عبر المؤسسات بالتعريف.
//
// **لماذا الإغلاق هو الصحيح الآن:** التطبيق لا يستخدم Storage إطلاقاً — المرفقات
// والصور تُحفظ base64 داخل Firestore (خطة Spark). و`uploadFile`/`uploadPhoto`
// مستورَدتان وغير مُستدعَاتين. فالإغلاق لا يُفقد وظيفة واحدة، ويُسكِت الثغرة.
//
// **عند تفعيل Storage مستقبلاً:** عزل المؤسسات هنا يحتاج `orgId` في مُطالَبات
// الرمز (custom claims)، لأن قواعد Storage لا تستطيع استعلام Firestore. الخطوات:
//   1. اكتب orgId كـ custom claim عند تسجيل الدخول/الانضمام.
//   2. استبدل القاعدة أدناه بـ:
//        match /orgs/{orgId}/{allPaths=**} {
//          allow read, write: if request.auth != null
//                             && request.auth.token.orgId == orgId
//                             && request.resource.size < 20 * 1024 * 1024;
//        }
//   3. أصلح `lib/storageService.ts` — يثبّت `orgs/main` (ثابت المؤسسة الواحدة
//      القديم) فيكتب كل المؤسسات في مسار واحد.
// ─────────────────────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
